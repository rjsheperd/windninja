diff --git a/src/OSspecific/POSIX/signals/sigFpe.C b/src/OSspecific/POSIX/signals/sigFpe.C
index ae9099d9..c8ea563c 100644
--- a/src/OSspecific/POSIX/signals/sigFpe.C
+++ b/src/OSspecific/POSIX/signals/sigFpe.C
@@ -38,7 +38,11 @@ License
 #endif
 
 #if defined(darwin64)
+#if defined(__x86_64__)
 #include <xmmintrin.h>
+#else
+#include <fenv.h>
+#endif
 #include <sys/mman.h>
 #include <unistd.h>
 #endif
@@ -212,8 +216,17 @@ void Foam::sigFpe::set(const bool verbose)
         );
         #endif  // LINUX_GNUC
         #if defined(darwin64)
+        #if defined(__x86_64__)
         _mm_setcsr(_MM_MASK_MASK &~
                    (_MM_MASK_OVERFLOW|_MM_MASK_INVALID|_MM_MASK_DIV_ZERO));
+        #else
+        // arm64: enable FP traps via FPCR (traps arrive as SIGILL, not SIGFPE)
+        fenv_t fenv;
+        fegetenv(&fenv);
+        fenv.__fpcr |= __fpcr_trap_invalid|__fpcr_trap_divbyzero
+                     | __fpcr_trap_overflow;
+        fesetenv(&fenv);
+        #endif
         #endif
 
         struct sigaction newAction;
